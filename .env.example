# Firebase web config (Firebase console → Project settings → Your apps → Web app).
# These values are public client identifiers, not secrets; security comes from
# firestore.rules and storage.rules. Copy this file to .env.local and fill it in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# UID of the single admin account (Firebase console → Authentication → Users).
# Only used to show/hide the admin UI; the real check is in the security rules.
VITE_ADMIN_UID=

# Public site URL, used for canonical links and social previews (no trailing slash).
VITE_SITE_URL=
